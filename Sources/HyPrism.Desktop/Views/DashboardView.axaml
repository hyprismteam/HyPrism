<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HyPrism.Desktop.ViewModels"
             x:Class="HyPrism.Desktop.Views.DashboardView"
             x:Name="DashboardRoot"
             x:DataType="vm:MainWindowViewModel"
             Classes.compact="{Binding IsCompactDashboardLayout}"
             ClipToBounds="False">
  <Border x:Name="DashboardSurface"
          CornerRadius="23"
          ClipToBounds="True">
    <Grid Background="#0D0E10">
    <Image Source="{Binding DashboardBackground}"
           Stretch="UniformToFill"
           Opacity="0.72">
      <Image.RenderTransform>
        <ScaleTransform ScaleX="1.025" ScaleY="1.025" />
      </Image.RenderTransform>
    </Image>

    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Color="#9E090A0C" Offset="0" />
          <GradientStop Color="#38090A0C" Offset="0.48" />
          <GradientStop Color="#75090A0C" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Color="#30090A0C" Offset="0" />
          <GradientStop Color="#18090A0C" Offset="0.34" />
          <GradientStop Color="#CC090A0C" Offset="0.78" />
          <GradientStop Color="#FF090A0C" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid RowDefinitions="*,Auto">
      <StackPanel Grid.Row="0"
                  Classes="dashboardHero"
                  Width="620"
                  MaxWidth="620"
                  Margin="28,24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <Border Classes="dashboardStatus" HorizontalAlignment="Center">
          <TextBlock Text="{Binding SelectedInstanceState}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     TextWrapping="NoWrap" />
        </Border>

        <TextBlock Classes="dashboardTitle"
                   Text="{Binding SelectedInstanceName}"
                   Margin="0,4,0,0"
                   FontWeight="Bold"
                   MaxLines="2"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding SelectedInstanceMeta}"
                   Foreground="#D0D1D5"
                   FontSize="14"
                   FontWeight="Medium"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="NoWrap" />

        <StackPanel Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12">
          <Button Classes="dashboardInstance"
                  IsVisible="{Binding HasDashboardInstances}"
                  Command="{Binding OpenInstancesCommand}"
                  ToolTip.Tip="{Binding InstancesLabel}">
            <Path Width="22"
                  Height="22"
                  Stretch="Uniform"
                  Data="{StaticResource InstancesIcon}" />
          </Button>

          <Button Classes="primary dashboardPrimary"
                  IsEnabled="{Binding CanRunPrimaryAction}"
                  Command="{Binding PrimaryActionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path IsVisible="{Binding IsPrimarySelectAction}"
                    Classes="actionIcon"
                    Width="18"
                    Height="18"
                    Stretch="Uniform"
                    Data="{StaticResource InstancesFilledIcon}" />
              <Path IsVisible="{Binding IsPrimaryPlayAction}"
                    Classes="actionIcon"
                    Width="18"
                    Height="18"
                    Stretch="Uniform"
                    Data="{StaticResource PlayIcon}" />
              <Path IsVisible="{Binding IsPrimaryDownloadAction}"
                    Classes="actionIcon"
                    Width="18"
                    Height="18"
                    Stretch="Uniform"
                    Data="{StaticResource DownloadIcon}" />
              <Path IsVisible="{Binding IsPrimaryStopAction}"
                    Classes="actionIcon"
                    Width="16"
                    Height="16"
                    Stretch="Uniform"
                    Data="{StaticResource StopIcon}" />
              <Ellipse IsVisible="{Binding IsPrimaryPendingAction}"
                       Width="9"
                       Height="9"
                       Fill="#111111" />
              <TextBlock Text="{Binding PrimaryActionText}"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Classes="dashboardActivity"
                IsVisible="{Binding IsActivityVisible}"
                Width="430"
                Margin="0,10,0,0"
                HorizontalAlignment="Center">
          <StackPanel Spacing="9">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBlock Text="{Binding ActivityTitle}"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ActivityProgressText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontWeight="SemiBold"
                         TextWrapping="NoWrap" />
            </Grid>
            <TextBlock Text="{Binding ActivityDetail}"
                       Classes="muted"
                       FontSize="12"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Height="4"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Value="{Binding ActivityProgress}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Row="1"
              IsVisible="{Binding IsDashboardQuickStripVisible}"
              Background="#D00B0C0E"
              Padding="28,18,28,22">
        <Grid Classes="dashboardQuickStrip"
              MaxWidth="1050"
              HorizontalAlignment="Stretch"
              RowDefinitions="Auto,Auto"
              RowSpacing="12">
          <Button Classes="dashboardLink"
                  HorizontalAlignment="Left"
                  Command="{Binding OpenInstancesCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="{Binding InstancesLabel}"
                         FontSize="17"
                         FontWeight="SemiBold" />
              <Path Width="13"
                    Height="13"
                    Stretch="Uniform"
                    Data="{StaticResource NextIcon}" />
            </StackPanel>
          </Button>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding Instances}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InstanceItemViewModel">
                <Button Classes="dashboardQuickInstance"
                        Classes.selected="{Binding IsSelected}"
                        Command="{Binding DataContext.SelectDashboardInstanceCommand, ElementName=DashboardRoot}"
                        CommandParameter="{Binding Id}">
                  <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="12"
                            Background="#14FFFFFF">
                      <TextBlock Text="{Binding Initial}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontWeight="Bold" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap" />
                      <TextBlock Text="{Binding Branch}"
                                 Classes="muted"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap" />
                    </StackPanel>
                    <Ellipse Grid.Column="2"
                             IsVisible="{Binding IsSelected}"
                             Width="6"
                             Height="6"
                             Margin="8,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource TextPrimaryBrush}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
