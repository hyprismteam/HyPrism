<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HyPrism.Desktop.ViewModels"
             xmlns:controls="using:HyPrism.Desktop.Controls"
             xmlns:easing="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
             x:Class="HyPrism.Desktop.Views.SettingsView"
             x:Name="SettingsRoot"
             x:DataType="vm:SettingsViewModel"
             SizeChanged="OnSettingsViewSizeChanged">
  <UserControl.Resources>
    <DataTemplate x:Key="SettingChoiceTemplate" x:DataType="vm:SettingChoiceViewModel">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border Width="24"
                Height="16"
                CornerRadius="3"
                ClipToBounds="True"
                VerticalAlignment="Center"
                IsVisible="{Binding HasIcon}">
          <Image Source="{Binding Icon}"
                 Stretch="UniformToFill"
                 IsHitTestVisible="False" />
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{Binding Display}"
                   TextWrapping="NoWrap"
                   VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <ControlTheme x:Key="SettingsComboBoxItemTheme" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}">
            <ContentPresenter.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
              </Transitions>
            </ContentPresenter.Transitions>
          </ContentPresenter>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#10FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      </Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1DFFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      </Style>
      <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#27FFFFFF" />
      </Style>
    </ControlTheme>

    <DataTemplate x:Key="SettingRailCategoryTemplate" x:DataType="vm:SettingCategoryViewModel">
      <Button Classes="settingsRailCategory"
              Classes.compact="{Binding DataContext.IsCompactLayout, ElementName=SettingsRoot}"
              Classes.selected="{Binding IsSelected}"
              HorizontalAlignment="Stretch"
              Click="OnSettingsCategoryClicked"
              Command="{Binding DataContext.SelectCategoryCommand, ElementName=SettingsRoot}"
              CommandParameter="{Binding}">
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
          <Border Classes="settingsCategoryIconFrame">
            <Image Classes="settingsCategoryIcon"
                   Source="{Binding Icon}"
                   Stretch="Uniform"
                   IsHitTestVisible="False" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="{Binding Label}"
                       Classes="settingsCategoryTitle"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Description}"
                       Classes="settingsCategoryDescription"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="SettingsLayout"
        ColumnDefinitions="276,*"
        ClipToBounds="True"
        Background="{DynamicResource SurfaceBrush}">
    <Border x:Name="SettingsCategoryRail"
            Grid.Column="0"
            Classes="settingsRail">
      <ScrollViewer x:Name="SettingsCategoryScroll"
                    Classes="settingsCategoryScroll"
                    Margin="14,18,4,18"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Categories}"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,10,0"
                      ItemTemplate="{StaticResource SettingRailCategoryTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel HorizontalAlignment="Stretch" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid x:Name="SettingsMain"
          Grid.Column="1"
          RowDefinitions="Auto,Auto,*"
          Background="{DynamicResource SurfaceBrush}"
          ZIndex="1">
      <Grid.RenderTransform>
        <TranslateTransform>
          <TranslateTransform.Transitions>
            <Transitions>
              <DoubleTransition Property="X" Duration="0:0:0.3">
                <DoubleTransition.Easing>
                  <easing:CubicEaseInOut />
                </DoubleTransition.Easing>
              </DoubleTransition>
            </Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Grid.RenderTransform>

      <Border x:Name="CompactSettingsToolbar"
              Classes="articleToolbar compact scrolled"
              IsVisible="False"
              IsHitTestVisible="True">
        <Grid ColumnDefinitions="*,Auto,*">
          <Button Classes="articleBack"
                  HorizontalAlignment="Left"
                  Click="OnCompactSettingsBackClicked">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Path Width="12"
                    Height="12"
                    Stretch="Uniform"
                    RenderTransformOrigin="50%,50%"
                    Data="{StaticResource NextIcon}">
                <Path.RenderTransform>
                  <RotateTransform Angle="180" />
                </Path.RenderTransform>
              </Path>
              <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock x:Name="CompactSettingsTitle"
                     Grid.Column="1"
                     Classes="articleToolbarTitle"
                     Text="{Binding ActiveCategoryTitle}"
                     Margin="12,0"
                     MaxWidth="280"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap"
                     FontSize="16"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />

          <TextBlock Grid.Column="2"
                     Text="{Binding StatusMessage}"
                     Margin="12,0,0,0"
                     FontSize="20"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Foreground="#A9E8BE" />
        </Grid>
      </Border>

      <Grid x:Name="SettingsHeader"
            Grid.Row="1"
            Margin="32,23,32,16"
            MaxWidth="980"
            HorizontalAlignment="Stretch"
            ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding ActiveCategoryTitle}"
                     FontSize="28"
                     FontWeight="Bold" />
          <TextBlock x:Name="SettingsPageSubtitle"
                     Text="{Binding PageDescription}"
                     Classes="muted"
                     FontSize="13" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusMessage}"
                   Margin="16,0,0,0"
                   FontSize="20"
                   VerticalAlignment="Center"
                   Foreground="#A9E8BE" />
      </Grid>

      <ScrollViewer x:Name="SettingsContent"
                    Grid.Row="2"
                    Classes="settingsScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid x:Name="SettingsContentHost"
              Margin="32,2,32,40"
              MaxWidth="980"
              HorizontalAlignment="Stretch">
          <StackPanel Spacing="14" IsVisible="{Binding IsGeneral}">
            <Border Classes="settingsGroup">
              <StackPanel>
                <Border Classes="settingsRow last">
                  <Grid ColumnDefinitions="*,220" ColumnSpacing="24">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding LanguageLabel}" Classes="settingsLabel" />
                      <TextBlock Text="{Binding LanguageHint}" Classes="settingsHint" />
                    </StackPanel>
                    <controls:FadingComboBox Grid.Column="1"
                                             ItemsSource="{Binding Languages}"
                                             ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                             ItemContainerTheme="{StaticResource SettingsComboBoxItemTheme}"
                                             SelectedItem="{Binding SelectedLanguage}" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="settingsGroup">
              <StackPanel>
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding CloseAfterLaunchLabel}" Classes="settingsLabel" />
                      <TextBlock Text="{Binding CloseAfterLaunchHint}" Classes="settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseAfterLaunch}" />
                  </Grid>
                </Border>
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding AlphaModsLabel}" Classes="settingsLabel" />
                      <TextBlock Text="{Binding AlphaModsHint}" Classes="settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowAlphaMods}" />
                  </Grid>
                </Border>
                <Border Classes="settingsRow last">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding DiscordAnnouncementsLabel}" Classes="settingsLabel" />
                      <TextBlock Text="{Binding DiscordAnnouncementsHint}" Classes="settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowDiscordAnnouncements}" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsDownloads}">
            <Border Classes="settingsGroup">
              <Border Classes="settingsRow last">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding LaunchAfterDownloadLabel}" Classes="settingsLabel" />
                    <TextBlock Text="{Binding LaunchAfterDownloadHint}" Classes="settingsHint" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAfterDownload}" />
                </Grid>
              </Border>
            </Border>
            <Border Classes="settingsInfoCard">
              <TextBlock Text="{Binding DownloadsInfo}" Classes="settingsHint" />
            </Border>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsJava}">
            <Border Classes="settingsGroup">
              <StackPanel>
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding CustomJavaLabel}" Classes="settingsLabel" />
                      <TextBlock Text="{Binding JavaRuntimeHint}" Classes="settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomJava}" />
                  </Grid>
                </Border>
                <Border Classes="settingsRow last">
                  <TextBox Text="{Binding CustomJavaPath}"
                           PlaceholderText="{Binding CustomJavaPathPlaceholder}"
                           IsEnabled="{Binding UseCustomJava}" />
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="settingsGroup settingsFormGroup">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding JavaArgumentsLabel}" Classes="settingsLabel" />
                <TextBlock Text="{Binding JavaArgumentsHint}" Classes="settingsHint" />
                <TextBox Text="{Binding JavaArguments}" AcceptsReturn="True" MinHeight="104" />
                <Button Classes="settingsAction" Command="{Binding SaveJavaCommand}" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding SaveLabel}" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsVisual}">
            <Border Classes="settingsGroup">
              <StackPanel>
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,220" ColumnSpacing="24">
                    <TextBlock Text="{Binding BackgroundLabel}" Classes="settingsLabel" VerticalAlignment="Center" />
                    <controls:FadingComboBox Grid.Column="1"
                                             ItemsSource="{Binding Backgrounds}"
                                             ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                             ItemContainerTheme="{StaticResource SettingsComboBoxItemTheme}"
                                             SelectedItem="{Binding SelectedBackground}" />
                  </Grid>
                </Border>
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding MusicLabel}" Classes="settingsLabel" />
                      <TextBlock Text="{Binding MusicHint}" Classes="settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding MusicEnabled}" />
                  </Grid>
                </Border>
                <Border Classes="settingsRow last">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding HideNewsLabel}" Classes="settingsLabel" />
                      <TextBlock Text="{Binding HideNewsHint}" Classes="settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding DisableNews}" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsNetwork}">
            <Border Classes="settingsGroup">
              <StackPanel>
                <Border Classes="settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding OnlineModeLabel}" Classes="settingsLabel" />
                      <TextBlock Text="{Binding OnlineModeHint}" Classes="settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding OnlineMode}" />
                  </Grid>
                </Border>
                <Border Classes="settingsRow last">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding DualAuthLabel}" Classes="settingsLabel" />
                      <TextBlock Text="{Binding DualAuthHint}" Classes="settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseDualAuth}" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="settingsGroup settingsFormGroup">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding AuthServerLabel}" Classes="settingsLabel" />
                <TextBlock Text="{Binding AuthServerHint}" Classes="settingsHint" />
                <TextBox Text="{Binding AuthDomain}" />
                <Button Classes="settingsAction" Command="{Binding SaveNetworkCommand}" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding SaveLabel}" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsGraphics}">
            <Border Classes="settingsGroup">
              <Border Classes="settingsRow last">
                <Grid ColumnDefinitions="*,220" ColumnSpacing="24">
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GpuLabel}" Classes="settingsLabel" />
                    <TextBlock Text="{Binding GpuHint}" Classes="settingsHint" />
                  </StackPanel>
                  <controls:FadingComboBox Grid.Column="1"
                                           ItemsSource="{Binding GpuPreferences}"
                                           ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                           ItemContainerTheme="{StaticResource SettingsComboBoxItemTheme}"
                                           SelectedItem="{Binding SelectedGpuPreference}" />
                </Grid>
              </Border>
            </Border>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsVariables}">
            <Border Classes="settingsInfoCard">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding EnvPresetsLabel}" Classes="settingsLabel" />
                <Border Classes="settingsCodeLine"><TextBlock Text="SDL_VIDEODRIVER=x11" FontFamily="JetBrains Mono" /></Border>
                <Border Classes="settingsCodeLine"><TextBlock Text="VK_LOADER_LAYERS_DISABLE=all" FontFamily="JetBrains Mono" /></Border>
              </StackPanel>
            </Border>
            <Border Classes="settingsGroup settingsFormGroup">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding EnvLabel}" Classes="settingsLabel" />
                <TextBlock Text="{Binding EnvHint}" Classes="settingsHint" />
                <TextBox Text="{Binding GameEnvironmentVariables}"
                         AcceptsReturn="True"
                         MinHeight="150"
                         FontFamily="JetBrains Mono" />
                <Button Classes="settingsAction" Command="{Binding SaveVariablesCommand}" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding SaveLabel}" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsData}">
            <Border Classes="settingsGroup">
              <Border Classes="settingsRow last">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding InstanceFolderLabel}" Classes="settingsLabel" />
                  <TextBlock Text="{Binding InstanceFolder}" Classes="settingsHint" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Border>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsAbout}">
            <Border Classes="settingsGroup settingsFormGroup">
              <StackPanel Spacing="8">
                <TextBlock Text="HyPrism Launcher" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding AboutDescription}" Classes="settingsHint" />
                <TextBlock Text="{Binding AboutDisclaimer}" Classes="settingsHint" FontSize="11" />
              </StackPanel>
            </Border>
            <Border Classes="settingsGroup">
              <StackPanel>
                <Button Classes="settingsLink" Command="{Binding OpenGitHubCommand}"><TextBlock Text="GitHub" /></Button>
                <Button Classes="settingsLink" Command="{Binding OpenDiscordCommand}"><TextBlock Text="Discord" /></Button>
                <Button Classes="settingsLink" Command="{Binding OpenBugReportCommand}"><TextBlock Text="{Binding BugReportLabel}" /></Button>
                <Button Classes="settingsLink" Command="{Binding OpenIcons8Command}"><TextBlock Text="Icons by Icons8" /></Button>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="14" IsVisible="{Binding IsDeveloper}">
            <Border Classes="settingsWarningCard">
              <TextBlock Text="{Binding DeveloperWarning}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="settingsGroup">
              <Border Classes="settingsRow last">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                  <TextBlock Text="{Binding ReplayIntroLabel}" Classes="settingsLabel" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="settingsAction" Command="{Binding ResetOnboardingCommand}">
                    <TextBlock Text="{Binding ReplayIntroLabel}" />
                  </Button>
                </Grid>
              </Border>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
