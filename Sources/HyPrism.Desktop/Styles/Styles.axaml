  </Style>

  <Style Selector="settings|SettingsView ToggleSwitch:pointerover /template/ Ellipse#SettingsSwitchKnob">
    <Setter Property="Fill" Value="#FFFFFF" />
  </Style>

  <Style Selector="settings|SettingsView ToggleSwitch:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

