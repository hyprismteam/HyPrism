  <Style Selector="settings|SettingsView TextBox">
    <Setter Property="Background" Value="#141517" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="settings|SettingsView TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#141517" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="settings|SettingsView TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#1A1B1E" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="settings|SettingsView TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#1D1E21" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="settings|SettingsView :is(ComboBox)">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="#141517" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,6,42,6" />
  </Style>

  <Style Selector="settings|SettingsView controls|FadingComboBox">
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid ColumnDefinitions="*,32">
            <Border x:Name="Background"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="HighlightBackground"
                    Grid.ColumnSpan="2"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsVisible="False" />
            <ContentControl x:Name="ContentPresenter"
                            Grid.Column="0"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <PathIcon x:Name="DropDownGlyph"
                      Grid.Column="1"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
            <Popup x:Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsOpen="{Binding IsPopupVisible, RelativeSource={RelativeSource TemplatedParent}}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   PlacementTarget="Background"
                   VerticalOffset="8"
                   IsLightDismissEnabled="False"
                   IsHitTestVisible="{TemplateBinding IsDropDownOpen}"
                   InheritsTransform="True">
              <Border x:Name="PopupBorder"
                      Background="#1D1E21"
                      HorizontalAlignment="Stretch"
                      IsHitTestVisible="{TemplateBinding IsDropDownOpen}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              IsScrollChainingEnabled="False">
                  <ItemsPresenter x:Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="settings|SettingsView :is(ComboBox) /template/ Border#Background">
    <Setter Property="Background" Value="#141517" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="settings|SettingsView :is(ComboBox):pointerover /template/ Border#Background">
    <Setter Property="Background" Value="#1A1B1E" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="settings|SettingsView :is(ComboBox):dropdownopen /template/ Border#Background">
    <Setter Property="Background" Value="#1D1E21" />
  </Style>

  <Style Selector="settings|SettingsView :is(ComboBox):focus-visible /template/ Border#HighlightBackground">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="settings|SettingsView :is(ComboBox) /template/ PathIcon#DropDownGlyph">
    <Setter Property="Data" Value="{StaticResource ExpandMoreIcon}" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="0,0,14,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="settings|SettingsView :is(ComboBox):pointerover /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="settings|SettingsView :is(ComboBox):dropdownopen /template/ PathIcon#DropDownGlyph">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="settings|SettingsView :is(ComboBox) /template/ Border#PopupBorder">
    <Setter Property="Background" Value="#1D1E21" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="BoxShadow" Value="0 12 36 0 #80000000" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.19">
          <DoubleTransition.Easing>
            <easing:CubicEaseInOut />
          </DoubleTransition.Easing>
        </DoubleTransition>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="settings|SettingsView ToggleSwitch">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
    <Setter Property="KnobTransitions">
      <Transitions>
        <DoubleTransition Property="Canvas.Left" Duration="0:0:0.22">
          <DoubleTransition.Easing>
            <easing:CubicEaseInOut />
          </DoubleTransition.Easing>
        </DoubleTransition>
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Width="48" Height="28" Background="Transparent">
          <Border x:Name="SettingsSwitchTrack"
                  Width="46"
                  Height="26"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#303237"
                  BorderThickness="0"
                  CornerRadius="13">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Canvas x:Name="PART_SwitchKnob"
                  Width="22"
                  Height="28"
                  Margin="2,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <Grid x:Name="PART_MovingKnobs" Width="22" Height="28">
              <Grid.Transitions>
                <Transitions>
                  <DoubleTransition Property="Canvas.Left" Duration="0:0:0.22">
                    <DoubleTransition.Easing>
                      <easing:CubicEaseInOut />
                    </DoubleTransition.Easing>
                  </DoubleTransition>
                </Transitions>
              </Grid.Transitions>
              <Ellipse x:Name="SettingsSwitchKnob"
                       Width="18"
                       Height="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Fill="#F4F5F6">
                <Ellipse.Transitions>
                  <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.18" />
                  </Transitions>
                </Ellipse.Transitions>
              </Ellipse>
            </Grid>
          </Canvas>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="settings|SettingsView ToggleSwitch:pointerover /template/ Border#SettingsSwitchTrack">
    <Setter Property="Background" Value="#3B3E43" />
  </Style>

  <Style Selector="settings|SettingsView ToggleSwitch:checked /template/ Border#SettingsSwitchTrack">
    <Setter Property="Background" Value="#35A85B" />
  </Style>

  <Style Selector="settings|SettingsView ToggleSwitch:checked:pointerover /template/ Border#SettingsSwitchTrack">
