<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:HyPrism.Desktop.Shell"
             xmlns:dashboard="using:HyPrism.Desktop.Features.Dashboard"
             x:Class="HyPrism.Desktop.Features.Dashboard.DashboardView"
             x:Name="DashboardRoot"
             x:DataType="shell:MainWindowViewModel"
             Classes.compact="{Binding IsCompactDashboardLayout}"
             ClipToBounds="False">
  <Border x:Name="DashboardSurface"
          CornerRadius="23"
          ClipToBounds="True">
    <Grid Background="#0D0E10">
    <Image Source="{Binding DashboardBackground}"
           Stretch="UniformToFill"
           Opacity="0.72">
      <Image.RenderTransform>
        <ScaleTransform ScaleX="1.025" ScaleY="1.025" />
      </Image.RenderTransform>
    </Image>

    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Color="#9E090A0C" Offset="0" />
          <GradientStop Color="#38090A0C" Offset="0.48" />
          <GradientStop Color="#75090A0C" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
          <GradientStop Color="#30090A0C" Offset="0" />
          <GradientStop Color="#18090A0C" Offset="0.34" />
          <GradientStop Color="#CC090A0C" Offset="0.78" />
          <GradientStop Color="#FF090A0C" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid>
      <StackPanel
                  Classes="dashboardHero"
                  Width="660"
                  MaxWidth="660"
                  Margin="44,32"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16">
        <StackPanel IsVisible="{Binding !HasSelectedInstance}"
                    HorizontalAlignment="Center"
                    MaxWidth="500"
                    Spacing="14">
          <Border Classes="dashboardHeroIcon" HorizontalAlignment="Center">
            <Path Width="32" Height="32" Stretch="Uniform" Data="{StaticResource InstancesFilledIcon}" />
          </Border>
          <TextBlock Text="{Binding HomeWelcomeTitle}" Classes="dashboardTitle" FontWeight="Bold" TextAlignment="Center" />
          <TextBlock Text="{Binding HomeWelcomeHint}" Classes="dashboardSubtitle" TextAlignment="Center" TextWrapping="Wrap" />
          <Button Classes="primary dashboardPrimary" HorizontalAlignment="Center" Margin="0,10,0,0" Command="{Binding PrimaryActionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Classes="actionIcon" Width="18" Height="18" Stretch="Uniform" Data="{StaticResource InstancesFilledIcon}" />
              <TextBlock Text="{Binding HomeCreateInstanceLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasSelectedInstance}" HorizontalAlignment="Center" MaxWidth="580" Spacing="13">
          <TextBlock Text="{Binding HomeCurrentInstanceLabel}" Classes="eyebrow" HorizontalAlignment="Center" />
          <TextBlock Classes="dashboardTitle" Text="{Binding SelectedInstanceName}" FontWeight="Bold" MaxLines="2" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding SelectedInstanceMeta}" Classes="dashboardSubtitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" />
          <Button Classes="primary dashboardPrimary"
                  HorizontalAlignment="Center"
                  Margin="0,14,0,0"
                  IsEnabled="{Binding CanRunPrimaryAction}"
                  Command="{Binding PrimaryActionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path IsVisible="{Binding IsPrimaryPlayAction}" Classes="actionIcon" Width="18" Height="18" Stretch="Uniform" Data="{StaticResource PlayIcon}" />
              <Path IsVisible="{Binding IsPrimaryDownloadAction}" Classes="actionIcon" Width="18" Height="18" Stretch="Uniform" Data="{StaticResource DownloadIcon}" />
              <Path IsVisible="{Binding IsPrimaryStopAction}" Classes="actionIcon" Width="16" Height="16" Stretch="Uniform" Data="{StaticResource StopIcon}" />
              <Ellipse IsVisible="{Binding IsPrimaryPendingAction}" Width="9" Height="9" Fill="#111111" />
              <TextBlock Text="{Binding PrimaryActionText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Classes="dashboardActivity"
                IsVisible="{Binding IsActivityVisible}"
                Width="430"
                Margin="0,10,0,0"
                HorizontalAlignment="Center">
          <StackPanel Spacing="9">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBlock Text="{Binding ActivityTitle}"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ActivityProgressText}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontWeight="SemiBold"
                         TextWrapping="NoWrap" />
            </Grid>
            <TextBlock Text="{Binding ActivityDetail}"
                       Classes="muted"
                       FontSize="12"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Height="4"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Value="{Binding ActivityProgress}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    </Grid>
  </Border>
</UserControl>
