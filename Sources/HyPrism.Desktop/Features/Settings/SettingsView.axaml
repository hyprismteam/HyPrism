<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HyPrism.Desktop.Features.Settings"
             xmlns:controls="using:HyPrism.Desktop.Controls"
             xmlns:easing="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
             x:Class="HyPrism.Desktop.Features.Settings.SettingsView"
             x:Name="SettingsRoot"
             x:DataType="vm:SettingsViewModel"
             SizeChanged="OnSettingsViewSizeChanged">
  <UserControl.Resources>
    <ControlTheme x:Key="SourceAddButtonTheme" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover, ^:pressed">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </ControlTheme>

    <DataTemplate x:Key="SettingChoiceTemplate" x:DataType="vm:SettingChoiceViewModel">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border Width="24"
                Height="16"
                CornerRadius="3"
                ClipToBounds="True"
                VerticalAlignment="Center"
                IsVisible="{Binding HasIcon}">
          <Image Source="{Binding Icon}"
                 Stretch="UniformToFill"
                 IsHitTestVisible="False" />
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{Binding Display}"
                   TextWrapping="NoWrap"
                   VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>


    <ControlTheme x:Key="JavaSliderTrackButtonTheme" TargetType="RepeatButton">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Height="8"
                  VerticalAlignment="Center"
                  Background="{TemplateBinding Background}"
                  CornerRadius="999">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="JavaSliderThumbTheme" TargetType="Thumb">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="JavaSliderThumbVisual"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="999"
                  BoxShadow="0 2 6 0 #99000000">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="JavaMemorySliderTheme" TargetType="Slider">
      <Setter Property="Height" Value="28" />
      <Setter Property="Background" Value="#24FFFFFF" />
      <Setter Property="Foreground" Value="#E8E8EA" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="Transparent">
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   Orientation="Horizontal">
              <Track.DecreaseButton>
                <RepeatButton Theme="{StaticResource JavaSliderTrackButtonTheme}"
                              Background="{TemplateBinding Foreground}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Theme="{StaticResource JavaSliderTrackButtonTheme}"
                              Background="{TemplateBinding Background}" />
              </Track.IncreaseButton>
              <Track.Thumb>
                <Thumb x:Name="JavaMemorySliderThumb"
                       Theme="{StaticResource JavaSliderThumbTheme}"
                       Background="{TemplateBinding Foreground}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="#32FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
      </Style>
    </ControlTheme>

    <DataTemplate x:Key="SettingRailCategoryTemplate" x:DataType="vm:SettingCategoryViewModel">
      <Button Classes="settingsRailCategory"
              Classes.compact="{Binding DataContext.IsCompactLayout, ElementName=SettingsRoot}"
              Classes.selected="{Binding IsSelected}"
              HorizontalAlignment="Stretch"
              Click="OnSettingsCategoryClicked"
              Command="{Binding DataContext.SelectCategoryCommand, ElementName=SettingsRoot}"
              CommandParameter="{Binding}">
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
          <Border Classes="settingsCategoryIconFrame">
            <Image Classes="settingsCategoryIcon"
                   Source="{Binding Icon}"
                   Stretch="Uniform"
                   IsHitTestVisible="False" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="{Binding Label}"
                       Classes="settingsCategoryTitle"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Description}"
                       Classes="settingsCategoryDescription"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="MirrorSourceTemplate" x:DataType="vm:MirrorSourceViewModel">
      <Border Classes="uiSettingsRow settingsRow mirrorSourceRow"
              Classes.last="{Binding IsLast}">
        <Grid ColumnDefinitions="2.3*,1.05*,1.15*,70,Auto,Auto" ColumnSpacing="14">
          <TextBlock Text="{Binding Endpoint}"
                     Classes="sourceTableValue link"
                     ToolTip.Tip="{Binding Name}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1"
                     Text="{Binding SourceType}"
                     Classes="sourceTableValue"
                     TextTrimming="CharacterEllipsis" />
          <Grid Grid.Column="2"
                Classes="sourceAvailability"
                ToolTip.Tip="{Binding Availability}">
            <PathIcon Data="{StaticResource CheckIcon}"
                      Classes="sourceAvailabilityIcon available"
                      IsVisible="{Binding IsAvailable}" />
            <PathIcon Data="{StaticResource CloseIcon}"
                      Classes="sourceAvailabilityIcon unavailable"
                      IsVisible="{Binding IsUnavailable}" />
          </Grid>
          <TextBlock Grid.Column="3"
                     Text="{Binding Ping}"
                     Classes="sourceTableValue ping" />
          <ToggleSwitch Grid.Column="4"
                        Classes="uiToggle"
                        IsChecked="{Binding IsEnabled}"
                        VerticalAlignment="Center" />
          <Button Grid.Column="5"
                  Classes="mirrorRemove"
                  Command="{Binding DataContext.RequestDeleteMirrorCommand, ElementName=SettingsRoot}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="{Binding DataContext.RemoveLabel, ElementName=SettingsRoot}">
            <TextBlock Text="×" FontSize="22" FontWeight="Normal" />
          </Button>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AboutTeamMemberTemplate" x:DataType="vm:AboutTeamMemberViewModel">
      <Button Classes="aboutTeamMember"
              Command="{Binding DataContext.OpenTeamMemberCommand, ElementName=SettingsRoot}"
              CommandParameter="{Binding}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="aboutTeamAvatar">
            <Grid>
              <Image Source="{Binding Avatar}"
                     IsVisible="{Binding HasAvatar}"
                     Stretch="UniformToFill" />
              <TextBlock Text="{Binding Initials}"
                         IsVisible="{Binding !HasAvatar}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="12"
                         FontWeight="Bold" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}"
                       Classes="uiSettingsLabel settingsLabel"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Role}"
                       Classes="aboutTeamRole"
                       MaxLines="2"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="AboutContributorTemplate" x:DataType="vm:AboutContributorViewModel">
      <Button Classes="aboutContributor"
              Command="{Binding DataContext.OpenContributorCommand, ElementName=SettingsRoot}"
              CommandParameter="{Binding}"
              ToolTip.Tip="{Binding Login}">
        <Border Classes="aboutContributorAvatar">
          <Grid>
            <Image Source="{Binding Avatar}"
                   IsVisible="{Binding HasAvatar}"
                   Stretch="UniformToFill" />
            <TextBlock Text="{Binding Initial}"
                       IsVisible="{Binding !HasAvatar}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Bold" />
          </Grid>
        </Border>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="SettingsLayout"
        ColumnDefinitions="276,*"
        ClipToBounds="True"
        Background="{DynamicResource SurfaceBrush}">
    <Border x:Name="SettingsCategoryRail"
            Grid.Column="0"
            Classes="settingsRail">
      <ScrollViewer x:Name="SettingsCategoryScroll"
                    Classes="settingsCategoryScroll"
                    Margin="14,18,4,18"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Categories}"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,10,0"
                      ItemTemplate="{StaticResource SettingRailCategoryTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel HorizontalAlignment="Stretch" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid x:Name="SettingsMain"
          Grid.Column="1"
          RowDefinitions="Auto,*"
          Background="{DynamicResource SurfaceBrush}"
          ZIndex="1">
      <Grid.RenderTransform>
        <TranslateTransform>
          <TranslateTransform.Transitions>
            <Transitions>
              <DoubleTransition Property="X" Duration="0:0:0.3">
                <DoubleTransition.Easing>
                  <easing:CubicEaseInOut />
                </DoubleTransition.Easing>
              </DoubleTransition>
            </Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Grid.RenderTransform>

      <Border x:Name="CompactSettingsToolbar"
              Classes="articleToolbar compact scrolled"
              IsVisible="False"
              IsHitTestVisible="True">
        <Grid ColumnDefinitions="*,Auto,*">
          <Button Classes="articleBack"
                  HorizontalAlignment="Left"
                  Click="OnCompactSettingsBackClicked">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Path Width="12"
                    Height="12"
                    Stretch="Uniform"
                    RenderTransformOrigin="50%,50%"
                    Data="{StaticResource NextIcon}">
                <Path.RenderTransform>
                  <RotateTransform Angle="180" />
                </Path.RenderTransform>
              </Path>
              <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock x:Name="CompactSettingsTitle"
                     Grid.Column="1"
                     Classes="articleToolbarTitle"
                     Text="{Binding ActiveCategoryTitle}"
                     Margin="12,0"
                     MaxWidth="280"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap"
                     FontSize="16"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />

          <TextBlock Grid.Column="2"
                     Text="{Binding StatusMessage}"
                     Margin="12,0,0,0"
                     FontSize="20"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource SuccessSoftBrush}" />
        </Grid>
      </Border>

      <ScrollViewer x:Name="SettingsContent"
                    Grid.Row="1"
                    Classes="settingsScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid x:Name="SettingsContentHost"
              Margin="32,28,32,40"
              MaxWidth="720"
              HorizontalAlignment="Stretch">
          <StackPanel Spacing="22" IsVisible="{Binding IsGeneral}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding LanguageCategoryTitle}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <Border Classes="uiSettingsRow settingsRow">
                  <Grid ColumnDefinitions="*,220" ColumnSpacing="24">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding LanguageLabel}" Classes="uiSettingsLabel settingsLabel" />
                      <TextBlock Text="{Binding LanguageHint}" Classes="uiSettingsHint settingsHint" />
                    </StackPanel>
                    <controls:FadingComboBox Grid.Column="1"
                                             Classes="uiComboBox"
                                             ItemsSource="{Binding Languages}"
                                             ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                             ItemContainerTheme="{StaticResource UiComboBoxItemTheme}"
                                             SelectedItem="{Binding SelectedLanguage}" />
                  </Grid>
                </Border>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{Binding GeneralTitle}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <StackPanel>
                <Border Classes="uiSettingsRow settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding CloseAfterLaunchLabel}" Classes="uiSettingsLabel settingsLabel" />
                      <TextBlock Text="{Binding CloseAfterLaunchHint}" Classes="uiSettingsHint settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="uiToggle" IsChecked="{Binding CloseAfterLaunch}" />
                  </Grid>
                </Border>
                <Border Classes="uiSettingsRow settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding AlphaModsLabel}" Classes="uiSettingsLabel settingsLabel" />
                      <TextBlock Text="{Binding AlphaModsHint}" Classes="uiSettingsHint settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="uiToggle" IsChecked="{Binding ShowAlphaMods}" />
                  </Grid>
                </Border>
                <Border Classes="uiSettingsRow settingsRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding DiscordAnnouncementsLabel}" Classes="uiSettingsLabel settingsLabel" />
                      <TextBlock Text="{Binding DiscordAnnouncementsHint}" Classes="uiSettingsHint settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="uiToggle" IsChecked="{Binding ShowDiscordAnnouncements}" />
                  </Grid>
                </Border>
                <Border Classes="uiSettingsRow settingsRow last">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding MusicLabel}" Classes="uiSettingsLabel settingsLabel" />
                      <TextBlock Text="{Binding MusicHint}" Classes="uiSettingsHint settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="uiToggle" IsChecked="{Binding MusicEnabled}" />
                  </Grid>
                </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="22" IsVisible="{Binding IsDownloads}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="4,0,4,2">
                <TextBlock Text="{Binding DownloadSourcesTitle}"
                           Classes="settingsCategoryHeading"
                           Margin="0"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="sourceAdd"
                        Theme="{StaticResource SourceAddButtonTheme}"
                        Command="{Binding ShowAddMirrorCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="+" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AddSourceButtonLabel}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>

              <Border Classes="uiSettingsGroup settingsGroup">
                <StackPanel>
                  <Border Classes="sourceTableHeader">
                    <Grid ColumnDefinitions="2.3*,1.05*,1.15*,70,82" ColumnSpacing="14">
                      <TextBlock Text="{Binding SourceLinkColumn}" />
                      <TextBlock Grid.Column="1" Text="{Binding SourceTypeColumn}" />
                      <TextBlock Grid.Column="2" Text="{Binding SourceAvailabilityColumn}" />
                      <TextBlock Grid.Column="3" Text="{Binding SourcePingColumn}" />
                    </Grid>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow"
                          Classes.last="{Binding HasNoMirrors}">
                    <Grid ColumnDefinitions="2.3*,1.05*,1.15*,70,82" ColumnSpacing="14">
                      <TextBlock Text="{Binding OfficialSourceLink}"
                                 Classes="sourceTableValue link"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding OfficialSourceType}"
                                 Classes="sourceTableValue" />
                      <Grid Grid.Column="2"
                            Classes="sourceAvailability"
                            ToolTip.Tip="{Binding OfficialSourceAvailability}">
                        <PathIcon Data="{StaticResource CheckIcon}"
                                  Classes="sourceAvailabilityIcon available"
                                  IsVisible="{Binding OfficialSourceIsAvailable}" />
                        <PathIcon Data="{StaticResource CloseIcon}"
                                  Classes="sourceAvailabilityIcon unavailable"
                                  IsVisible="{Binding OfficialSourceIsUnavailable}" />
                      </Grid>
                      <TextBlock Grid.Column="3"
                                 Text="{Binding OfficialSourcePing}"
                                 Classes="sourceTableValue ping" />
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding MirrorSources}"
                                ItemTemplate="{StaticResource MirrorSourceTemplate}"
                                IsVisible="{Binding HasMirrors}" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding DownloadsInfo}"
                         Classes="settingsHint sourceSelectionHint" />

              <Border Classes="uiSettingsGroup settingsGroup"
                      IsVisible="{Binding IsAddingMirror}">
                <StackPanel>
                  <Border Classes="uiSettingsRow settingsRow">
                    <StackPanel Spacing="5">
                      <TextBlock Text="{Binding AddSourceTitle}" Classes="uiSettingsLabel settingsLabel" />
                      <TextBlock Text="{Binding AddSourceHint}" Classes="uiSettingsHint settingsHint" />
                    </StackPanel>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow last">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                      <TextBox Text="{Binding MirrorUrl}"
                               PlaceholderText="{Binding MirrorUrlPlaceholder}"
                               IsEnabled="{Binding !IsMirrorOperationBusy}" />
                      <Button Grid.Column="1"
                              Classes="sourceCancel"
                              Command="{Binding CancelAddMirrorCommand}"
                              IsEnabled="{Binding !IsMirrorOperationBusy}"
                              Content="{Binding CancelLabel}" />
                      <Button Grid.Column="2"
                              Classes="settingsAction"
                              Command="{Binding AddMirrorCommand}"
                              IsEnabled="{Binding !IsMirrorOperationBusy}"
                              Content="{Binding AddSourceLabel}" />
                    </Grid>
                  </Border>
                  <ProgressBar Classes="sourceProgress"
                               IsIndeterminate="True"
                               IsVisible="{Binding IsMirrorOperationBusy}" />
                </StackPanel>
              </Border>

              <Border Classes="uiSettingsGroup settingsGroup" IsVisible="{Binding HasPendingMirrorDelete}">
                <Border Classes="uiSettingsRow settingsRow last">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding DeleteSourceTitle}" Classes="uiSettingsLabel settingsLabel" />
                      <TextBlock Text="{Binding DeleteSourceHint}" Classes="uiSettingsHint settingsHint" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="sourceCancel"
                            Command="{Binding CancelDeleteMirrorCommand}"
                            Content="{Binding CancelLabel}" />
                    <Button Grid.Column="2"
                            Classes="sourceRemoveConfirm"
                            Command="{Binding ConfirmDeleteMirrorCommand}"
                            Content="{Binding RemoveLabel}" />
                  </Grid>
                </Border>
              </Border>

              <TextBlock Text="{Binding MirrorOperationStatus}"
                         Classes="sourceOperationStatus"
                         IsVisible="{Binding HasMirrorOperationStatus}" />
              <TextBlock Text="{Binding MirrorOperationError}"
                         Classes="sourceOperationError"
                         IsVisible="{Binding HasMirrorOperationError}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="22" IsVisible="{Binding IsJava}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding JavaRuntimeLabel}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <StackPanel>
                  <Border Classes="uiSettingsRow settingsRow runtime">
                    <Button Classes="javaRuntimeOption"
                            Classes.selected="{Binding UseBundledJava}"
                            Command="{Binding SelectBundledJavaCommand}">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Classes="javaRadioIndicator">
                          <Ellipse Classes="javaRadioDot" IsVisible="{Binding UseBundledJava}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding BundledJavaLabel}" Classes="uiSettingsLabel settingsLabel" />
                          <TextBlock Text="{Binding BundledJavaHint}" Classes="uiSettingsHint settingsHint" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow runtime last">
                    <StackPanel>
                      <Button Classes="javaRuntimeOption"
                              Classes.selected="{Binding UseCustomJava}"
                              Command="{Binding SelectCustomJavaCommand}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                          <Border Classes="javaRadioIndicator">
                            <Ellipse Classes="javaRadioDot" IsVisible="{Binding UseCustomJava}" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding CustomJavaLabel}" Classes="uiSettingsLabel settingsLabel" />
                            <TextBlock Text="{Binding CustomJavaHint}" Classes="uiSettingsHint settingsHint" />
                          </StackPanel>
                        </Grid>
                      </Button>
                      <StackPanel Margin="18,4,18,14" Spacing="8" IsVisible="{Binding UseCustomJava}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBox Text="{Binding CustomJavaPath}"
                                   PlaceholderText="{Binding CustomJavaPathPlaceholder}"
                                   VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="javaInlineAction" Command="{Binding BrowseJavaCommand}">
                            <TextBlock Text="{Binding SelectLabel}" />
                          </Button>
                          <Button Grid.Column="2" Classes="settingsAction" Command="{Binding SaveJavaPathCommand}">
                            <TextBlock Text="{Binding SaveLabel}" />
                          </Button>
                        </Grid>
                        <TextBlock Text="{Binding JavaPathError}" Classes="settingsError" IsVisible="{Binding HasJavaPathError}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{Binding RamAllocationLabel}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <StackPanel>
                  <Border Classes="uiSettingsRow settingsRow">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding MaximumRamLabel}" Classes="uiSettingsLabel settingsLabel" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding JavaMaximumRamValue}" Classes="javaMemoryValue" />
                      </Grid>
                      <Slider x:Name="JavaMaximumMemorySlider"
                              Theme="{StaticResource JavaMemorySliderTheme}"
                              Minimum="{Binding MinimumJavaRamMb}"
                              Maximum="{Binding MaximumJavaRamMb}"
                              TickFrequency="{Binding JavaMemoryTickFrequency}"
                              IsSnapToTickEnabled="True"
                              Value="{Binding JavaMaximumRamMb, Mode=TwoWay}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow last">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding InitialRamLabel}" Classes="uiSettingsLabel settingsLabel" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding JavaInitialRamValue}" Classes="javaMemoryValue" />
                      </Grid>
                      <Slider x:Name="JavaInitialMemorySlider"
                              Theme="{StaticResource JavaMemorySliderTheme}"
                              Minimum="{Binding MinimumJavaRamMb}"
                              Maximum="{Binding JavaInitialRamMaximum}"
                              TickFrequency="{Binding JavaMemoryTickFrequency}"
                              IsSnapToTickEnabled="True"
                              Value="{Binding JavaInitialRamMb, Mode=TwoWay}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{Binding JavaArgumentsLabel}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <Border Classes="uiSettingsRow settingsRow last">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding JavaArgumentsHint}" Classes="uiSettingsHint settingsHint" />
                    <TextBox Text="{Binding JavaArguments}"
                             PlaceholderText="{Binding JavaArgumentsPlaceholder}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="104" />
                    <TextBlock Text="{Binding JavaArgumentsError}" Classes="settingsError" IsVisible="{Binding HasJavaArgumentsError}" />
                    <Button Classes="settingsAction" Command="{Binding SaveJavaArgumentsCommand}" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding SaveLabel}" />
                    </Button>
                  </StackPanel>
                </Border>
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="22" IsVisible="{Binding IsVisual}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding VisualTitle}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <Border Classes="uiSettingsRow settingsRow last">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding HideNewsLabel}" Classes="uiSettingsLabel settingsLabel" />
                      <TextBlock Text="{Binding HideNewsHint}" Classes="uiSettingsHint settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="uiToggle" IsChecked="{Binding DisableNews}" />
                  </Grid>
                </Border>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{Binding BackgroundLabel}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <Border Classes="uiSettingsRow settingsRow last">
                  <ItemsControl x:Name="BackgroundPicker"
                                ItemsSource="{Binding Backgrounds}"
                                HorizontalAlignment="Stretch"
                                SizeChanged="OnBackgroundPickerSizeChanged">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BackgroundChoiceViewModel">
                          <Button Classes="backgroundChoice"
                                  Classes.selected="{Binding IsSelected}"
                                  Command="{Binding DataContext.SelectBackgroundCommand, ElementName=SettingsRoot}"
                                  CommandParameter="{Binding}">
                            <Grid ClipToBounds="True">
                              <Image Source="{Binding Preview}" Stretch="UniformToFill" IsVisible="{Binding IsSingle}" />
                              <Grid ColumnDefinitions="*,*,*" IsVisible="{Binding IsAuto}">
                                <Image Source="{Binding PreviewOne}" Stretch="UniformToFill" />
                                <Image Grid.Column="1" Source="{Binding PreviewTwo}" Stretch="UniformToFill" />
                                <Image Grid.Column="2" Source="{Binding PreviewThree}" Stretch="UniformToFill" />
                              </Grid>
                              <Border Classes="backgroundAutoLabel" IsVisible="{Binding IsAuto}">
                                <TextBlock Text="{Binding Display}" />
                              </Border>
                              <Border Classes="backgroundSelectedIndicator" IsVisible="{Binding IsSelected}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="22" IsVisible="{Binding IsNetwork}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding NetworkTitle}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <StackPanel>
                <Border Classes="uiSettingsRow settingsRow last">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding OnlineModeLabel}" Classes="uiSettingsLabel settingsLabel" />
                      <TextBlock Text="{Binding OnlineModeHint}" Classes="uiSettingsHint settingsHint" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Classes="uiToggle" IsChecked="{Binding OnlineMode}" />
                  </Grid>
                </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{Binding AuthServerLabel}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <Border Classes="uiSettingsRow settingsRow last">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding AuthServerHint}" Classes="uiSettingsHint settingsHint" />
                    <TextBox Text="{Binding AuthDomain}" />
                    <Button Classes="settingsAction" Command="{Binding SaveNetworkCommand}" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding SaveLabel}" />
                    </Button>
                  </StackPanel>
                </Border>
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsGraphics}">
            <TextBlock Text="{Binding GpuLabel}" Classes="settingsCategoryHeading" />
            <Border Classes="uiSettingsGroup settingsGroup">
              <Border Classes="uiSettingsRow settingsRow last">
                <Grid ColumnDefinitions="*,220" ColumnSpacing="24">
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GpuHint}" Classes="uiSettingsHint settingsHint" />
                  </StackPanel>
                  <controls:FadingComboBox Grid.Column="1"
                                           Classes="uiComboBox"
                                           ItemsSource="{Binding GpuPreferences}"
                                           ItemTemplate="{StaticResource SettingChoiceTemplate}"
                                           ItemContainerTheme="{StaticResource UiComboBoxItemTheme}"
                                           SelectedItem="{Binding SelectedGpuPreference}" />
                </Grid>
              </Border>
            </Border>
          </StackPanel>

          <StackPanel Spacing="22" IsVisible="{Binding IsVariables}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding EnvPresetsLabel}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <Border Classes="uiSettingsRow settingsRow last">
                  <StackPanel Spacing="8">
                    <Border Classes="settingsCodeLine"><TextBlock Text="SDL_VIDEODRIVER=x11" FontFamily="JetBrains Mono" /></Border>
                    <Border Classes="settingsCodeLine"><TextBlock Text="VK_LOADER_LAYERS_DISABLE=all" FontFamily="JetBrains Mono" /></Border>
                  </StackPanel>
                </Border>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{Binding EnvLabel}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <Border Classes="uiSettingsRow settingsRow last">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding EnvHint}" Classes="uiSettingsHint settingsHint" />
                    <TextBox Text="{Binding GameEnvironmentVariables}" AcceptsReturn="True" MinHeight="150" FontFamily="JetBrains Mono" />
                    <Button Classes="settingsAction" Command="{Binding SaveVariablesCommand}" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding SaveLabel}" />
                    </Button>
                  </StackPanel>
                </Border>
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsData}">
            <TextBlock Text="{Binding InstanceFolderLabel}" Classes="settingsCategoryHeading" />
            <Border Classes="uiSettingsGroup settingsGroup">
              <Border Classes="uiSettingsRow settingsRow last">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding InstanceFolder}" Classes="uiSettingsHint settingsHint" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Border>
          </StackPanel>

          <StackPanel Spacing="22" IsVisible="{Binding IsAbout}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding AboutProjectTitle}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <StackPanel>
                  <Border Classes="uiSettingsRow settingsRow aboutRow">
                    <Grid MinHeight="66" Margin="18,0" ColumnDefinitions="*,Auto" ColumnSpacing="18">
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AboutCurrentVersionLabel}" Classes="uiSettingsLabel settingsLabel" />
                        <TextBlock Text="{Binding AboutCurrentVersionHint}" Classes="uiSettingsHint settingsHint" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="aboutLicenseValue">
                        <TextBlock Text="{Binding AboutCurrentVersion}" />
                      </Border>
                    </Grid>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow aboutRow">
                    <Button Classes="aboutLink"
                            Command="{Binding OpenLatestCommitCommand}"
                            IsEnabled="{Binding HasAboutLatestCommit}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding AboutLatestCommitLabel}" Classes="uiSettingsLabel settingsLabel" />
                          <TextBlock Text="{Binding AboutLatestCommitHint}"
                                     Classes="uiSettingsHint settingsHint"
                                     MaxLines="1"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Classes="aboutLicenseValue"
                                IsVisible="{Binding HasAboutLatestCommit}">
                          <TextBlock Text="{Binding AboutLatestCommitSha}" FontFamily="JetBrains Mono" />
                        </Border>
                      </Grid>
                    </Button>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow aboutRow">
                    <Button Classes="aboutLink" Command="{Binding OpenGitHubCommand}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="GitHub" Classes="uiSettingsLabel settingsLabel" />
                          <TextBlock Text="{Binding AboutGitHubHint}" Classes="uiSettingsHint settingsHint" />
                        </StackPanel>
                        <Path Grid.Column="1" Classes="aboutOpenIcon" Data="{StaticResource OpenIcon}" />
                      </Grid>
                    </Button>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow aboutRow last">
                    <Button Classes="aboutLink" Command="{Binding OpenDocumentationCommand}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding AboutDocumentationLabel}" Classes="uiSettingsLabel settingsLabel" />
                          <TextBlock Text="{Binding AboutDocumentationHint}" Classes="uiSettingsHint settingsHint" />
                        </StackPanel>
                        <Path Grid.Column="1" Classes="aboutOpenIcon" Data="{StaticResource OpenIcon}" />
                      </Grid>
                    </Button>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{Binding AboutCommunityTitle}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <StackPanel>
                  <Border Classes="uiSettingsRow settingsRow aboutRow">
                    <Button Classes="aboutLink" Command="{Binding OpenDiscordCommand}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="Discord" Classes="uiSettingsLabel settingsLabel" />
                          <TextBlock Text="{Binding AboutDiscordHint}" Classes="uiSettingsHint settingsHint" />
                        </StackPanel>
                        <Path Grid.Column="1" Classes="aboutOpenIcon" Data="{StaticResource OpenIcon}" />
                      </Grid>
                    </Button>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow aboutRow last">
                    <Button Classes="aboutLink" Command="{Binding OpenBugReportCommand}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding BugReportLabel}" Classes="uiSettingsLabel settingsLabel" />
                          <TextBlock Text="{Binding AboutBugReportHint}" Classes="uiSettingsHint settingsHint" />
                        </StackPanel>
                        <Path Grid.Column="1" Classes="aboutOpenIcon" Data="{StaticResource OpenIcon}" />
                      </Grid>
                    </Button>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{Binding AboutTeamTitle}" Classes="settingsCategoryHeading" />
              <Border Classes="settingsGroup aboutTeamGroup">
                <ItemsControl ItemsSource="{Binding AboutTeamMembers}"
                              ItemTemplate="{StaticResource AboutTeamMemberTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{Binding AboutContributorsTitle}" Classes="settingsCategoryHeading" />
              <Border x:Name="AboutContributorsContainer"
                      Classes="settingsGroup aboutContributorsGroup"
                      SizeChanged="OnAboutContributorsSizeChanged">
                <StackPanel x:Name="AboutContributorsRow"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                  <ItemsControl ItemsSource="{Binding AboutContributors}"
                                ItemTemplate="{StaticResource AboutContributorTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <Button Classes="aboutContributor overflow"
                          IsVisible="{Binding HasMoreAboutContributors}"
                          Command="{Binding OpenAllContributorsCommand}"
                          ToolTip.Tip="{Binding AboutContributorsTitle}">
                    <Border Classes="aboutContributorAvatar overflow">
                      <TextBlock Text="{Binding AboutContributorOverflow}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="13"
                                 FontWeight="Bold" />
                    </Border>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="{Binding AboutLegalTitle}" Classes="settingsCategoryHeading" />
              <Border Classes="uiSettingsGroup settingsGroup">
                <StackPanel>
                  <Border Classes="uiSettingsRow settingsRow aboutRow">
                    <Button Classes="aboutLink" Command="{Binding OpenLicenseCommand}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding AboutLicenseLabel}" Classes="uiSettingsLabel settingsLabel" />
                          <TextBlock Text="{Binding AboutLicenseHint}" Classes="uiSettingsHint settingsHint" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="aboutLicenseValue">
                          <TextBlock Text="GPL-3.0-only" />
                        </Border>
                      </Grid>
                    </Button>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow aboutRow">
                    <Button Classes="aboutLink" Command="{Binding OpenHytaleEulaCommand}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding AboutHytaleEulaLabel}" Classes="uiSettingsLabel settingsLabel" />
                          <TextBlock Text="{Binding AboutHytaleEulaHint}" Classes="uiSettingsHint settingsHint" />
                        </StackPanel>
                        <Path Grid.Column="1" Classes="aboutOpenIcon" Data="{StaticResource OpenIcon}" />
                      </Grid>
                    </Button>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow aboutRow">
                    <Button Classes="aboutLink" Command="{Binding OpenIcons8Command}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding AboutCreditsLabel}" Classes="uiSettingsLabel settingsLabel" />
                          <TextBlock Text="{Binding AboutCreditsHint}" Classes="uiSettingsHint settingsHint" />
                        </StackPanel>
                        <Path Grid.Column="1" Classes="aboutOpenIcon" Data="{StaticResource OpenIcon}" />
                      </Grid>
                    </Button>
                  </Border>
                  <Border Classes="uiSettingsRow settingsRow aboutRow last">
                    <Button Classes="aboutLink" Command="{Binding OpenLordiconCommand}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding AboutLordiconLabel}" Classes="uiSettingsLabel settingsLabel" />
                          <TextBlock Text="{Binding AboutLordiconHint}" Classes="uiSettingsHint settingsHint" />
                        </StackPanel>
                        <Path Grid.Column="1" Classes="aboutOpenIcon" Data="{StaticResource OpenIcon}" />
                      </Grid>
                    </Button>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding AboutDisclaimer}"
                         Classes="aboutDisclaimer"
                         Margin="4,2,4,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
