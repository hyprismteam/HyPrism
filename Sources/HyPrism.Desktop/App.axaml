<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HyPrism.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HyPrism.Desktop/Assets/Icons/MaterialSymbols.axaml" />
        <ResourceInclude Source="avares://HyPrism.Desktop/Assets/Brands/CurseForge.axaml" />
        <ResourceInclude Source="avares://HyPrism.Desktop/Assets/Brands/Avalonia.axaml" />
        <ResourceInclude Source="avares://HyPrism.Desktop/Assets/Brands/DotNet.axaml" />
        <ResourceInclude Source="avares://HyPrism.Desktop/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <FontFamily x:Key="GoogleSansFont">avares://HyPrism.Desktop/Assets/Fonts#Google Sans</FontFamily>
      <FontFamily x:Key="JetBrainsMonoFont">avares://HyPrism.Desktop/Assets/Fonts#JetBrains Mono</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://HyPrism.Desktop/Styles/Controls.axaml" />
    <StyleInclude Source="avares://HyPrism.Desktop/Styles/Styles.axaml" />
  </Application.Styles>
</Application>
