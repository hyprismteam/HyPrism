{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "strict": true
  },
  "include": [
    "docusaurus.config.ts",
    "plugins/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "build",
    "out",
    ".docusaurus"
  ]
}
